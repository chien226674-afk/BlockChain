# NFT Marketplace - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nft_marketplace?retryWrites=true&w=majority&authSource=admin

# JWT Secret (MUST be at least 32 characters for security)
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-for-security

# IPFS / Pinata (for NFT image storage)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# CORS Configuration (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Security Configuration (Optional - defaults are set)
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_API_MAX=100
# NONCE_TTL_MINUTES=15

# Blockchain (Add when deploying contracts)
# NFT_CONTRACT_ADDRESS=0x...
# MARKETPLACE_CONTRACT_ADDRESS=0x...
# PROVIDER_URL=http://localhost:8545
